--- a/src/Limelight.h
+++ b/src/Limelight.h
@@ -124,6 +124,15 @@ typedef struct _STREAM_CONFIGURATION {
     // Zero (the default) sends nothing. Hosts that do not know them ignore them.
     int pyrowavePaceMbps;
     int pyrowaveLinkMbps;
+
+    // The host's Remote Input app: the host sends no video or audio (Rubylight
+    // never captures or encodes for it). The video and audio streams start
+    // nothing, so no decoder, renderer, receive thread or missing-video timer
+    // runs; only the control and input streams do. The video port still gets
+    // the client's UDP ping, because Apollo and Vibepollo end an input-only
+    // session whose first video ping doesn't arrive within 10 seconds.
+    // Rubylight ignores that ping.
+    bool inputOnly;
 } STREAM_CONFIGURATION, *PSTREAM_CONFIGURATION;
 
