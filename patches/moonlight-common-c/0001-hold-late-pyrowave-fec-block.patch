@@ -54,6 +54,15 @@ typedef struct _RTP_VIDEO_QUEUE {
     uint8_t multiFecCurrentBlockNumber;
     uint8_t multiFecLastBlockNumber;
 
+    // PyroWave: packets of a later FEC block of the current frame that arrived before
+    // the block the queue is waiting for. They are replayed once that block completes,
+    // or dropped with the frame at earlyBlockDeadlineUs.
+    RTPV_QUEUE_LIST earlyBlockList;
+    uint64_t earlyBlockFirstUs;
