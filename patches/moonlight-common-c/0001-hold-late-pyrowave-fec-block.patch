diff --git a/tests/pyrowave_record_queue.c b/tests/pyrowave_record_queue.c
index bec1ebb..7e6b7a8 100644
--- a/tests/pyrowave_record_queue.c
+++ b/tests/pyrowave_record_queue.c
@@ -370,6 +370,89 @@ static void testMissingCriticalFromEarlierBlockBlocksExpiry(void) {
     RtpvCleanupQueue(&queue);
 }
 
+static void testLateFirstBlockIsHeld(void) {
+    RTP_VIDEO_QUEUE queue;
+    beginQueue(&queue, PYROWAVE_FORMAT);
+    // The first packets of block 1 overtake all of block 0, as seen over Wi-Fi
+    EXPECT(addPacket(&queue, 1, 1, 1, 0, 104, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, false, false, 0) == RTPF_RET_QUEUED,
+           "early block 1 packet is held");
+    addPacket(&queue, 1, 1, 1, 1, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    EXPECT(lostNotifications == 0, "early block does not drop the frame");
+    EXPECT(RtpvGetPendingFrameDeadlineUs(&queue) != 0, "held packets arm a deadline");
+    addFullFrame(&queue, 1, 100, 0, 1, true, 2);
+    addPacket(&queue, 1, 1, 1, 2, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 1, 1, 3, 104, FLAG_EOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    EXPECT(submittedPackets[1] == 2 * DATA_PACKETS && submittedLost[1] == 0, "frame completes once block 0 arrives");
+    EXPECT(lostNotifications == 0, "no frame is reported lost");
+    EXPECT(RtpvGetPendingFrameDeadlineUs(&queue) == 0, "completed frame leaves no deadline");
+    addFullFrame(&queue, 2, 108, 0, 0, true, 2);
+    EXPECT(submittedPackets[2] == DATA_PACKETS, "next frame is unaffected");
+    RtpvCleanupQueue(&queue);
+}
+
+static void testInterleavedLateFirstBlockIsHeld(void) {
+    RTP_VIDEO_QUEUE queue;
+    beginQueue(&queue, PYROWAVE_FORMAT);
+    addPacket(&queue, 1, 1, 1, 0, 104, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 0, 100, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, true, true, 2);
+    // Block 1 keeps arriving while block 0 is incomplete; it must not end block 0 early
+    addPacket(&queue, 1, 1, 1, 1, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 1, 100, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 2, 100, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 1, 1, 2, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 3, 100, FLAG_EOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 1, 1, 3, 104, FLAG_EOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    EXPECT(submittedPackets[1] == 2 * DATA_PACKETS && submittedLost[1] == 0, "interleaved blocks complete without holes");
+    EXPECT(lostNotifications == 0, "interleaved blocks drop nothing");
+    EXPECT(RtpvGetPendingFrameDeadlineUs(&queue) == 0, "interleaved frame leaves no deadline");
+    RtpvCleanupQueue(&queue);
+}
+
+static void testMissingFirstBlockDropsFrameAtDeadline(void) {
+    RTP_VIDEO_QUEUE queue;
+    beginQueue(&queue, PYROWAVE_FORMAT);
+    addPacket(&queue, 1, 1, 1, 0, 104, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    uint64_t deadline = RtpvGetPendingFrameDeadlineUs(&queue);
+    RtpvExpirePendingFrame(&queue, deadline - 1);
+    EXPECT(lostNotifications == 0, "frame is held until the deadline");
+    RtpvExpirePendingFrame(&queue, deadline);
+    EXPECT(lostNotifications == 1, "frame is reported lost at the deadline");
+    EXPECT(RtpvGetPendingFrameDeadlineUs(&queue) == 0, "dropping the frame clears the deadline");
+    EXPECT(addPacket(&queue, 1, 1, 1, 1, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0) == RTPF_RET_REJECTED,
+           "the rest of the dropped frame is rejected");
+    addFullFrame(&queue, 2, 108, 0, 0, true, 2);
+    EXPECT(submittedPackets[1] == 0 && submittedPackets[2] == DATA_PACKETS, "next frame is delivered");
+    RtpvCleanupQueue(&queue);
+}
+
+static void testPartialFirstBlockIsZeroFilledAtDeadline(void) {
+    RTP_VIDEO_QUEUE queue;
+    beginQueue(&queue, PYROWAVE_FORMAT);
+    addPacket(&queue, 1, 1, 1, 0, 104, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 0, 100, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, true, true, 1);
+    addPacket(&queue, 1, 0, 1, 1, 100, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 0, 1, 3, 100, FLAG_EOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 1, 1, 1, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    RtpvExpirePendingFrame(&queue, RtpvGetPendingFrameDeadlineUs(&queue));
+    EXPECT(lostNotifications == 0, "a partial block 0 is delivered rather than dropped");
+    addPacket(&queue, 1, 1, 1, 2, 104, FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    addPacket(&queue, 1, 1, 1, 3, 104, FLAG_EOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    EXPECT(submittedPackets[1] == 2 * DATA_PACKETS && submittedLost[1] == 1, "only the missing block 0 packet is zero-filled");
+    RtpvCleanupQueue(&queue);
+}
+
+static void testHeldPacketsOfAnEarlierFrameAreDropped(void) {
+    RTP_VIDEO_QUEUE queue;
+    beginQueue(&queue, PYROWAVE_FORMAT);
+    addPacket(&queue, 1, 1, 1, 0, 104, FLAG_SOF | FLAG_CONTAINS_PIC_DATA, false, false, 0);
+    // Frame 2 starts in order: frame 1 is given up and its held packets go with it
+    addFullFrame(&queue, 2, 108, 0, 0, true, 2);
+    EXPECT(submittedPackets[2] == DATA_PACKETS, "the next frame is delivered");
+    addFullFrame(&queue, 3, 112, 0, 0, true, 2);
+    EXPECT(submittedPackets[3] == DATA_PACKETS, "held packets of frame 1 do not block frame 3");
+    EXPECT(RtpvGetPendingFrameDeadlineUs(&queue) == 0, "no deadline is left for frame 1");
+    RtpvCleanupQueue(&queue);
+}
 
 bool isReferenceFrameInvalidationEnabled(void) { return false; }
 PYROWAVE_DIALECT LiGetPyroWaveDialect(void) { return dialect; }
