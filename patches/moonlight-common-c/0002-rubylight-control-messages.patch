diff --git a/src/RubylightControl.h b/src/RubylightControl.h
new file mode 100644
index 0000000..e670e0e
--- /dev/null
+++ b/src/RubylightControl.h
@@ -0,0 +1,89 @@
+// Rubylight control messages (Rubylight docs/control-messages.md; wire formats in
+// Nightjar's rubylight-protocol crate). The host's DESCRIBE answer names the
+// client-to-host messages it takes, on one or more lines:
+//   a=x-rl-control:0x5530,0x5531,0x5532
+// A client sends a message only when its id is listed. Ids are 16-bit, hexadecimal
+// with 0x or decimal; malformed entries are skipped and duplicates dropped.
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "Limelight.h"
+
+#define RL_MAX_CONTROL_MESSAGES 32
+
+// Host-to-client messages handed to ConnListenerRubylightMessage, with the
+// largest payload each may carry. A host timing report has a 4-byte header and
+// up to 32 records of 20 bytes, plus up to 16 extension bytes each.
+static inline int LiRubylightMaxPayload(uint16_t type) {
+    switch (type) {
+    case RL_HOST_TIMING: return 4 + 32 * (20 + 16);
+    case RL_CLOCK_SYNC: return 256;
+    case RL_LINK_NOTICE: return 64;
+    case RL_PIPELINE_RATES: return 64;
+    default: return 0;
+    }
+}
+
+static inline int LiRubylightHexDigit(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+// Parses one id from [start, end); false when it is not a whole 16-bit number.
+static inline bool LiRubylightParseId(const char* start, const char* end, uint16_t* id) {
+    while (start < end && (*start == ' ' || *start == '\t')) start++;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) end--;
+    unsigned int base = 10;
+    if (end - start > 2 && start[0] == '0' && (start[1] == 'x' || start[1] == 'X')) {
+        base = 16;
+        start += 2;
+    }
+    if (start == end) return false;
+    uint32_t value = 0;
+    for (; start < end; start++) {
+        int digit = LiRubylightHexDigit(*start);
+        if (digit < 0 || (unsigned int)digit >= base) return false;
+        value = value * base + (uint32_t)digit;
+        if (value > 0xFFFF) return false;
+    }
+    *id = (uint16_t)value;
+    return true;
+}
+
+// Returns how many ids the SDP's x-rl-control lines name (written to ids, at most
+// maxIds); 0 for hosts that send no such line.
+static inline int LiRubylightParseControlMessages(const char* sdp, uint16_t* ids, int maxIds) {
+    static const char prefix[] = "a=x-rl-control:";
+    const size_t prefixLength = sizeof(prefix) - 1;
+    int count = 0;
+    if (sdp == NULL) return 0;
+    for (const char* line = sdp; *line;) {
+        const char* end = strchr(line, '\n');
+        size_t length = end ? (size_t)(end - line) : strlen(line);
+        if (length && line[length - 1] == '\r') length--;
+        if (length > prefixLength && !memcmp(line, prefix, prefixLength)) {
+            const char* item = line + prefixLength;
+            const char* lineEnd = line + length;
+            while (item < lineEnd) {
+                const char* comma = (const char*)memchr(item, ',', (size_t)(lineEnd - item));
+                const char* itemEnd = comma ? comma : lineEnd;
+                uint16_t id;
+                if (LiRubylightParseId(item, itemEnd, &id)) {
+                    bool seen = false;
+                    for (int i = 0; i < count; i++) seen |= ids[i] == id;
+                    if (!seen && count < maxIds) ids[count++] = id;
+                }
+                item = itemEnd + 1;
+            }
+        }
+        if (!end) break;
+        line = end + 1;
+    }
+    return count;
+}
diff --git a/tests/rubylight_control.c b/tests/rubylight_control.c
new file mode 100644
index 0000000..98a4b5b
--- /dev/null
+++ b/tests/rubylight_control.c
@@ -0,0 +1,37 @@
+// Rubylight control negotiation: the ids a host lists in a=x-rl-control.
+#include "RubylightControl.h"
+#include <assert.h>
+#include <stdio.h>
+
+static int parse(const char* sdp, uint16_t* ids) {
+    return LiRubylightParseControlMessages(sdp, ids, RL_MAX_CONTROL_MESSAGES);
+}
+
+int main(void) {
+    uint16_t ids[RL_MAX_CONTROL_MESSAGES];
+
+    assert(parse(NULL, ids) == 0);
+    assert(parse("v=0\r\na=x-ss-general.featureFlags:3\r\n", ids) == 0);
+
+    // Rubylight 2.2.0's line, then 3.0's second line; both are read and merged.
+    assert(parse("a=x-rl-control:0x5530,0x5531,0x5532\r\n"
+                 "a=fmtp:97 surround-params=21101\r\n"
+                 "a=x-rl-control:0x5539,0x553b,0x553D,0x553e\r\n", ids) == 7);
+    assert(ids[0] == RL_PHASE_LOCK_REPORT && ids[2] == 0x5532 && ids[5] == RL_PIPELINE_RATES && ids[6] == 0x553E);
+
+    // Decimal ids, spaces, a missing final newline; duplicates and malformed entries are skipped.
+    assert(parse("a=x-rl-control: 21808 , 0x5536,0x5536,0xZZ,,70000,0x\na=x-rl-control:0x5537", ids) == 3);
+    assert(ids[0] == RL_PHASE_LOCK_REPORT && ids[1] == RL_HOST_TIMING && ids[2] == RL_CLOCK_SYNC);
+
+    // Only whole lines starting with the attribute count.
+    assert(parse("b=x-rl-control:0x5530\r\nxa=x-rl-control:0x5530\r\na=x-rl-control:\r\n", ids) == 0);
+
+    // At most maxIds are kept.
+    assert(LiRubylightParseControlMessages("a=x-rl-control:1,2,3,4", ids, 2) == 2 && ids[1] == 2);
+
+    assert(LiRubylightMaxPayload(RL_HOST_TIMING) == 1156);
+    assert(LiRubylightMaxPayload(RL_PHASE_LOCK_REPORT) == 0);
+
+    printf("rubylight control tests passed\n");
+    return 0;
+}
