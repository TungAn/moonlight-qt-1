+// Rubylight control messages the host listed in this connection's DESCRIBE answer.
+// Written on the connection thread before the control stream starts.
+static uint16_t rubylightMessages[RL_MAX_CONTROL_MESSAGES];
+static int rubylightMessageCount;
+
+void setRubylightControlMessages(const uint16_t* ids, int count) {
+    if (ids == NULL || count < 0) {
+        count = 0;
+    }
+    if (count > RL_MAX_CONTROL_MESSAGES) {
+        count = RL_MAX_CONTROL_MESSAGES;
+    }
+    rubylightMessageCount = 0;
+    if (count > 0) {
+        memcpy(rubylightMessages, ids, (size_t)count * sizeof(ids[0]));
+    }
+    rubylightMessageCount = count;
+}
+
+bool LiHostAcceptsRubylightMessage(uint16_t type) {
+    for (int i = 0; i < rubylightMessageCount; i++) {
+        if (rubylightMessages[i] == type) {
+            return true;
+        }
+    }
+    return false;
+}
+
+int LiSendRubylightMessage(uint16_t type, const void* payload, int length, bool reliable) {
+    if (!LiHostAcceptsRubylightMessage(type) || payload == NULL || length <= 0 || length > 1024 ||
+        !IS_SUNSHINE() || !encryptedControlStream || stopping || peer == NULL) {
+        return -1;
+    }
+    return sendMessageAndForget((short)type, (unsigned int)length, payload, CTRL_CHANNEL_GENERIC,
+                                reliable ? ENET_PACKET_FLAG_RELIABLE : ENET_PACKET_FLAG_UNSEQUENCED,
+                                false) ? 0 : -1;
+}
